# Bloquea el acceso web a código interno, configuración, SQL y scripts de terminal.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|sql|bin|tests)(/|$) - [F,L]
  RewriteRule ^config(\.example)?\.php$ - [F,L]
</IfModule>
<FilesMatch "^(config\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>
